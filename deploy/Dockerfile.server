# API + background jobs image (no LLM, no sandbox, no Lean on the server).
FROM python:3.13-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv
WORKDIR /src
COPY protocol protocol
COPY server server
# --no-sources: outside the uv workspace, proofxiv-protocol comes from ./protocol in this command
RUN uv venv /opt/proofxiv && \
    VIRTUAL_ENV=/opt/proofxiv uv pip install --no-cache --no-sources ./protocol ./server

FROM python:3.13-slim
RUN useradd --system --home /data proofxiv && mkdir -p /data && chown proofxiv /data
COPY --from=build /opt/proofxiv /opt/proofxiv
COPY server/alembic.ini /app/alembic.ini
COPY server/migrations /app/migrations
ENV PATH=/opt/proofxiv/bin:$PATH PROOFXIV_DATA_DIR=/data
WORKDIR /app
USER proofxiv
EXPOSE 8000
# one process: the short public cache is per process and is cleared on every write, so a
# second process could serve a page that is a few seconds stale right after a user action
CMD ["sh", "-c", "alembic upgrade head && proofxiv-server serve --host 0.0.0.0 --port 8000 --workers 1"]
