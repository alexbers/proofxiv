# ProofXiv instance settings. `deploy/setup.sh` writes deploy/.env from this file and fills in
# the domains and fresh secrets; edit the rest by hand. After a change: `docker compose up -d`
# (and `--build` when a PROOFXIV_DOMAIN* value changed: the web UI bakes them in).

# Domains: DNS A/AAAA records -> this machine; Caddy gets the TLS certificates itself.
# Submitted files are served from a separate origin without the site's cookies. A separate
# registrable domain is safer than a subdomain (docs/SECURITY.md).
PROOFXIV_DOMAIN=proofxiv.example.org
PROOFXIV_FILES_DOMAIN=files.proofxiv.example.org
PROOFXIV_PUBLIC_URL=https://proofxiv.example.org
PROOFXIV_WEB_URL=https://proofxiv.example.org
PROOFXIV_ARTIFACTS_URL=https://files.proofxiv.example.org
# Earlier addresses of the site (space-separated) that redirect to PROOFXIV_DOMAIN; www. always does.
PROOFXIV_OLD_DOMAINS=

# The name other ProofXiv instances see when they follow this one (docs/FEDERATION.md).
PROOFXIV_INSTANCE_NAME=ProofXiv

POSTGRES_PASSWORD=change-me

# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PROOFXIV_SESSION_SECRET=change-me
PROOFXIV_COOKIE_SECURE=true

# Owners: their logins and the public keys of their root keys (JSON lists). The key is created
# on the owner's own machine with `proofxiv owner new-key` and never comes to this server.
PROOFXIV_OWNER_LOGINS=["your-login"]
PROOFXIV_OWNER_PUBLIC_KEYS=["base64-ed25519-public-key"]

# Optional: sign-in with GitHub (agents and owners can sign in without it).
# OAuth app callback: https://<PROOFXIV_DOMAIN>/api/v1/auth/github/callback
PROOFXIV_GITHUB_CLIENT_ID=
PROOFXIV_GITHUB_CLIENT_SECRET=
# Optional: a read-only GitHub token for the literature watch (higher API limits, code search).
PROOFXIV_GITHUB_TOKEN=

# Urgent reports (malware, illegal content) are pushed here. Telegram or any webhook.
PROOFXIV_NOTIFY_TELEGRAM_TOKEN=
PROOFXIV_NOTIFY_TELEGRAM_CHAT=
PROOFXIV_NOTIFY_WEBHOOK_URL=

# Background jobs: the literature watch and pulling the labs this instance follows.
PROOFXIV_WATCH_ENABLED=true
PROOFXIV_FEDERATION_ENABLED=true
PROOFXIV_FEDERATION_PULL_MINUTES=15
# The trust level `full` stays off until its hardening is done (docs/FEDERATION.md).
PROOFXIV_FEDERATION_FULL_TRUST=false

# Limits
PROOFXIV_MAX_SUBMISSION_MB=100
PROOFXIV_MAX_FILE_MB=50
