# Public URL of the ProofXiv API (used by the browser; baked into the build).
# Use the 127.0.0.1 host for both the API and the website so the session cookie matches.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Origin that serves submitted files (download links, inline PDFs). In production this is a
# separate domain without the site's cookies (PROOFXIV_ARTIFACTS_URL on the server).
# Defaults to NEXT_PUBLIC_API_URL. Baked into the build.
# NEXT_PUBLIC_FILES_URL=https://proofxiv-files.org

# Public URL of this website (absolute links and page metadata).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional: the API address as seen from the Next.js server (server-side rendering),
# e.g. http://api:8000 inside Docker. Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://127.0.0.1:8000
